{
  "name": "RefractedView",
  "type": "object",
  "properties": {
    "topicSessionId": {
      "type": "string",
      "description": "Parent TopicSession identifier",
    },
    "lensId": {
      "type": "string",
      "description": "Lens identifier",
    },
    "title": {
      "type": "string",
      "description": "Generated title",
    },
    "summary": {
      "type": "string",
      "description": "Generated summary text",
    },
    "status": {
      "type": "string",
      "enum": ["draft", "generating", "ready", "failed"],
      "description": "Generation status",
    },
    "generationRunId": {
      "type": "string",
      "description": "Latest generation run identifier",
    },
    "retrievalEnabled": {
      "type": "boolean",
      "description": "Whether retrieval was used",
    },
    "retrievalSummary": {
      "type": "string",
      "description": "Optional retrieval notes",
    },
    "errorMessage": {
      "type": "string",
      "description": "Failure message",
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Completion timestamp",
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp",
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp",
    },
  },
  "required": ["topicSessionId", "lensId", "status", "retrievalEnabled"],
}
