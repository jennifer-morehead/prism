{
  "name": "TopicSession",
  "type": "object",
  "properties": {
    "topicText": {
      "type": "string",
      "description": "Original topic entered by the user",
    },
    "normalizedTopic": {
      "type": "string",
      "description": "Normalized topic used for matching and caching",
    },
    "status": {
      "type": "string",
      "enum": ["created", "lens_selected", "generating", "ready", "failed"],
      "description": "Lifecycle state for this topic session",
    },
    "selectedLensId": {
      "type": "string",
      "description": "Currently selected lens identifier",
    },
    "activeRefractedViewId": {
      "type": "string",
      "description": "Latest successful refracted view",
    },
    "generatedLenses": {
      "type": "array",
      "description": "Immutable AI-generated lens snapshot for this topic session",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "key": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "displayOrder": { "type": "integer" },
          "accentColor": { "type": ["string", "null"] },
          "isActive": { "type": "boolean" },
        },
        "required": [
          "id",
          "key",
          "name",
          "description",
          "displayOrder",
          "isActive",
        ],
      },
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp",
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp",
    },
  },
  "required": ["topicText", "normalizedTopic", "status"],
}
