{
  "name": "ConceptConnection",
  "type": "object",
  "properties": {
    "refractedViewId": {
      "type": "string",
      "description": "Parent RefractedView identifier",
    },
    "sourceConceptId": {
      "type": "string",
      "description": "Source Concept identifier",
    },
    "relationVerb": {
      "type": "string",
      "description": "Relationship verb between concepts",
    },
    "targetConceptId": {
      "type": "string",
      "description": "Target Concept identifier",
    },
    "rationale": {
      "type": "string",
      "description": "Optional explanation for the relationship",
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Optional relationship strength",
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp",
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp",
    },
  },
  "required": [
    "refractedViewId",
    "sourceConceptId",
    "relationVerb",
    "targetConceptId",
  ],
}
