{
  "name": "Concept",
  "type": "object",
  "properties": {
    "refractedViewId": {
      "type": "string",
      "description": "Parent RefractedView identifier",
    },
    "ordinal": {
      "type": "integer",
      "description": "Display order",
    },
    "title": {
      "type": "string",
      "description": "Concept title",
    },
    "body": {
      "type": "string",
      "description": "Concept explanation",
    },
    "searchQuery": {
      "type": "string",
      "description": "AI-generated educational search keywords for this concept",
    },
    "confidenceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Optional confidence from generation",
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp",
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp",
    },
  },
  "required": ["refractedViewId", "ordinal", "title", "body"],
}
